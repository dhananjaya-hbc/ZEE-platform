# ---------------------------------------------------------------------------
# ZEE AI service — environment template
#
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# MUST match AISERVICE__INTERNALKEY in apps/api/.env exactly.
# Minimum 16 characters; the service refuses to start without it.
# Generate with:  openssl rand -hex 32
INTERNAL_API_KEY=change-me-must-match-the-dotnet-api

# Neon (serverless PostgreSQL). Unused in Phase 1 — the service touches no
# database — but present so Phase 2 retrieval has somewhere to read from.
# Must point at the SAME Neon branch as the .NET API.
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@ep-CHANGE-ME-pooler.REGION.aws.neon.tech/zee?sslmode=require

# "development" enables /docs and /openapi.json. Anything else disables them.
ENVIRONMENT=development

LOG_LEVEL=INFO
