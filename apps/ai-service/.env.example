# ---------------------------------------------------------------------------
# ZEE AI service — environment template
#
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# MUST match AISERVICE__INTERNALKEY in apps/api/.env exactly.
# Minimum 16 characters; the service refuses to start without it.
# Generate with:  openssl rand -hex 32
INTERNAL_API_KEY=change-me-must-match-the-dotnet-api

# Unused in Phase 1 — the mocks touch no database. Present so Phase 2 retrieval
# has somewhere to read from. Host is "postgres" inside Docker Compose.
DATABASE_URL=postgresql://zee:zee@postgres:5432/zee

# "development" enables /docs and /openapi.json. Anything else disables them.
ENVIRONMENT=development

LOG_LEVEL=INFO
