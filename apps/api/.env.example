# ---------------------------------------------------------------------------
# ZEE API — environment template
#
# Copy to .env and fill in. NEVER commit .env (.gitignore blocks it).
#
# .NET maps nested configuration keys to environment variables using DOUBLE
# UNDERSCORES: ConnectionStrings__Postgres sets ConnectionStrings:Postgres.
# ---------------------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# --- Database (Neon) -------------------------------------------------------
# ZEE has no local database container. Create a free Neon project at
# https://neon.com and paste its .NET / ADO.NET connection string here.
#
# Use the POOLED endpoint (hostname contains "-pooler") for the running app, and
# the DIRECT endpoint (same host without "-pooler") for `dotnet ef database update`.
#
# Do NOT replace SSL Mode=VerifyFull with Trust Server Certificate=true - that
# turns off the check that stops a man-in-the-middle on your database traffic.
#
# See docs/Database.md.
ConnectionStrings__Postgres=Host=ep-CHANGE-ME-pooler.REGION.aws.neon.tech;Database=zee;Username=CHANGE_ME;Password=CHANGE_ME;SSL Mode=VerifyFull;Channel Binding=Require;No Reset On Close=true

# --- Cache / queue ---------------------------------------------------------
# Optional. If blank, the API falls back to an in-memory cache so it still runs.
ConnectionStrings__Redis=redis:6379

# --- Auth ------------------------------------------------------------------
# Signing key for the JWTs issued after a student redeems an emailed OTP.
# Must be at least 32 characters. Generate with:  openssl rand -base64 48
# A weak key here means anyone can forge a token for any student.
JWT__KEY=change-me-generate-a-real-key-at-least-32-chars
JWT__ISSUER=zee
JWT__ACCESSTOKENLIFETIMEMINUTES=60

# --- AI service ------------------------------------------------------------
# BaseUrl is the Compose service name; the AI service is not internet-facing.
AISERVICE__BASEURL=http://ai-service:8000

# MUST match INTERNAL_API_KEY in apps/ai-service/.env exactly. This shared secret
# is the only thing protecting the AI service from anyone who can reach its port.
# Generate with:  openssl rand -hex 32
AISERVICE__INTERNALKEY=change-me-must-match-ai-service

# Seconds before an AI call gives up. Kept short: every AI call is optional
# enrichment with a fallback, so failing fast beats blocking a student's feed.
AISERVICE__TIMEOUTSECONDS=5

# --- CORS ------------------------------------------------------------------
# Origins allowed to call this API from a browser. Comma-separated index syntax.
CORS__ALLOWEDORIGINS__0=http://localhost:3000
