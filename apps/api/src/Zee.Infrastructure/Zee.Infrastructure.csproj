<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure: everything that talks to the outside world.

    EF Core / PostgreSQL, the repository implementations behind the Domain
    interfaces, Redis caching, and AiServiceClient (the HttpClient that calls
    /apps/ai-service). All of it is reachable only through interfaces declared
    in Domain or Application, so nothing above this layer knows it exists.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zee.Application\Zee.Application.csproj" />
  </ItemGroup>

</Project>
