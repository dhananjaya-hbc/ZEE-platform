# ---------------------------------------------------------------------------
# ZEE web — environment template
#
# Copy to .env.local. NEVER commit it.
#
# WARNING: every NEXT_PUBLIC_* variable is inlined into the JavaScript bundle and
# is visible to anyone who opens devtools. Never put a secret behind that prefix.
# The web app needs no secrets: all privileged calls go through the .NET API.
# ---------------------------------------------------------------------------

# Base URL of the ZEE API as reached FROM THE BROWSER.
# Inside Docker Compose the API is published on localhost:5080.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Shown in the UI to make it obvious which environment you are looking at.
NEXT_PUBLIC_ENVIRONMENT=development
