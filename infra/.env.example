# ---------------------------------------------------------------------------
# Docker Compose environment.
#
#   cp infra/.env.example infra/.env
#
# Compose reads infra/.env automatically. NEVER commit it.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=zee
POSTGRES_PASSWORD=zee
POSTGRES_DB=zee
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379

# --- Shared internal secret ------------------------------------------------
# Used by BOTH the .NET API (as AiService__InternalKey) and the AI service (as
# INTERNAL_API_KEY). Compose injects the same value into both, which is why it
# lives here once rather than in two places that can drift apart.
#
# Generate with:  openssl rand -hex 32
INTERNAL_API_KEY=change-me-openssl-rand-hex-32

# --- API auth --------------------------------------------------------------
# Signing key for student JWTs. At least 32 characters.
# Generate with:  openssl rand -base64 48
JWT_KEY=change-me-generate-a-real-key-at-least-32-chars
JWT_ISSUER=zee

# --- Ports (host side) -----------------------------------------------------
API_PORT=5080
WEB_PORT=3000
AI_SERVICE_PORT=8000

# --- URLs ------------------------------------------------------------------
# Where the browser reaches the API. Baked into the web bundle at build time.
PUBLIC_API_BASE_URL=http://localhost:5080

# Origin allowed to call the API from a browser.
WEB_ORIGIN=http://localhost:3000

# --- Environment -----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ENVIRONMENT=development
LOG_LEVEL=INFO
