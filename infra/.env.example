# ---------------------------------------------------------------------------
# Docker Compose environment.
#
#   cp infra/.env.example infra/.env
#
# Compose reads infra/.env automatically. NEVER commit it.
# ---------------------------------------------------------------------------

# ===========================================================================
# DATABASE — Neon (serverless PostgreSQL)
#
# There is no database container. Create a free project at https://neon.com,
# then take the connection details from its dashboard.
#
# IMPORTANT: give yourself your OWN Neon branch rather than sharing one with
# other contributors — branches are instant and free, and sharing a dev database
# means you overwrite each other's data. See docs/Database.md.
#
# The same database is expressed TWICE below because .NET and Python want
# different formats. Both must point at the same branch.
# ===========================================================================

# --- For the .NET API: Npgsql key=value form -------------------------------
# Take the "ADO.NET" / ".NET" connection string from the Neon dashboard.
#
# Use the POOLED endpoint (hostname contains "-pooler") for the running app.
#   - SSL Mode=VerifyFull      Neon requires TLS and its certs are publicly
#                              trusted, so verify properly. Do NOT weaken this
#                              to Trust Server Certificate=true; that disables
#                              the check that stops a man-in-the-middle.
#   - Channel Binding=Require  Binds auth to the TLS channel.
#   - No Reset On Close=true   Required with the pooled endpoint, which is
#                              PgBouncer in transaction mode and does not
#                              support the session reset Npgsql sends by default.
NEON_NPGSQL_CONNECTION_STRING=Host=ep-CHANGE-ME-pooler.REGION.aws.neon.tech;Database=zee;Username=CHANGE_ME;Password=CHANGE_ME;SSL Mode=VerifyFull;Channel Binding=Require;No Reset On Close=true

# --- For the AI service: libpq URI form ------------------------------------
# Unused in Phase 1 (the service touches no database) but wired now so Phase 2
# retrieval has somewhere to read from.
NEON_DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@ep-CHANGE-ME-pooler.REGION.aws.neon.tech/zee?sslmode=require

# NOTE for MIGRATIONS: run `dotnet ef database update` against the DIRECT
# (unpooled) endpoint — the same host WITHOUT "-pooler". Schema changes want a
# real session, which transaction-mode pooling does not give you.
# See docs/Database.md.

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379

# ===========================================================================
# SECRETS
# ===========================================================================

# Shared internal secret, used by BOTH the .NET API (as AiService__InternalKey)
# and the AI service (as INTERNAL_API_KEY). Compose injects the same value into
# both, which is why it lives here once rather than in two places that can drift.
#
# Generate with:  openssl rand -hex 32
INTERNAL_API_KEY=change-me-openssl-rand-hex-32

# Signing key for student JWTs. At least 32 characters.
# Generate with:  openssl rand -base64 48
JWT_KEY=change-me-generate-a-real-key-at-least-32-chars
JWT_ISSUER=zee

# ===========================================================================
# PORTS AND URLS
# ===========================================================================

API_PORT=5080
WEB_PORT=3000
AI_SERVICE_PORT=8000

# Where the browser reaches the API. Baked into the web bundle at BUILD time.
PUBLIC_API_BASE_URL=http://localhost:5080

# Origin allowed to call the API from a browser.
WEB_ORIGIN=http://localhost:3000

# --- Environment -----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ENVIRONMENT=development
LOG_LEVEL=INFO
